MAX_MIDI = 127

# ---------------------------------------------------------------- type detection
TYPE_RULES = [
    (r"\b(bd|kick|bassdrum|kik|bdrum)\b|\bbass[\s_]?drum\b", "BD", True),
    (r"\b(sd|snare|snr|sn)\b",                       "SD", False),
    (r"\b(rim|rimshot|rs)\b|\brim[\s_]?shot\b",      "RS", False),
    (r"\b(clap|clp|cp|hclp)\b|\bhand[\s_]?clap\b",   "CP", False),
    (r"\b(oh|ohh|openhat|hho|hhopen|hhop)\b|\bopen[\s_]?hats?\b", "OH", False),
    (r"\b(ch|chh|hh|hhc|hat|hihat|hhclose|hhcl)\b|\bclosed?[\s_]?hats?\b|\bhi[\s_]?hat\b", "CH", False),
    (r"\b(ride|rd)\b|\bride[\s_]?cymbal\b",         "RD", False),
    (r"\b(crash|cr|crsh)\b",                        "CR", False),
    (r"\b(cym|cymb|cymbal|cy)\b",                   "CY", False),
    (r"\b(lt|lowtom|toml)\b|\blow[\s_]?tom\b|\btom[\s_]?lo\b",   "LT", True),
    (r"\b(mt|midtom|tomm)\b|\bmid[\s_]?tom\b|\btom[\s_]?mid\b",  "MT", True),
    (r"\b(ht|hitom|tomh)\b|\b(hi|high)[\s_]?tom\b|\btom[\s_]?hi\b", "HT", True),
    (r"\b(tom|tm)\b",                               "TM", True),
    (r"\b(cb|cowbell|cow)\b|\bcow[\s_]?bell\b",     "CB", True),
    (r"\b(clave|cl|clav)\b",                        "CL", True),
    (r"\b(conga|cga|cng)\b",                        "CG", True),
    (r"\b(bongo|bng)\b",                            "BG", True),
    (r"\b(guiro|gui|scraper)\b",                     "GU", False),
    (r"\b(shaker|shk|sh)\b",                        "SH", False),
    (r"\b(tamb|tambourine|tmb|tb)\b",               "TB", False),
    (r"\b(maraca|mar|mrc)\b",                       "MA", False),
    (r"\b(metal|metallic|anvil|beep)\b",             "ME", False),
    (r"\b(perc|prc|pc|wood|woodblock|trill)\b",     "PC", False),
    (r"\b(bass|bs|sub|subbass)\b",                  "BS", True),
    (r"\b(fx|sfx|effect|noise)\b",                  "FX", False),
]
TYPE_LABEL = {"BD":"Kick","SD":"Snare","RS":"Rimshot","CP":"Clap","CH":"Closed Hat",
    "OH":"Open Hat","RD":"Ride","CR":"Crash","CY":"Cymbal","LT":"Low Tom","MT":"Mid Tom",
    "HT":"Hi Tom","TM":"Tom","CB":"Cowbell","CL":"Clave","CG":"Conga","BG":"Bongo",
    "SH":"Shaker","TB":"Tambourine","MA":"Maraca","GU":"Guiro","ME":"Metal","PC":"Perc","BS":"Bass","FX":"FX","XX":"?"}
TONAL_BAND = {"BD":(30,250),"TM":(60,400),"LT":(50,250),"MT":(70,320),"HT":(90,450),
    "CB":(200,1500),"CL":(200,2500),"CG":(80,600),"BG":(120,900),"BS":(28,400)}
ORDER = ["BD","SD","RS","CP","CH","OH","RD","CR","CY","LT","MT","HT","TM",
         "CB","CL","CG","BG","SH","TB","MA","GU","ME","PC","BS","FX","XX"]

def detect_type(filename, machine=None):
    stem = os.path.splitext(os.path.basename(filename))[0]
    if machine:
        stem = re.sub(re.escape(machine), " ", stem, flags=re.I)
    stem = re.sub(r"(?<=[a-z0-9])(?=[A-Z])", " ", stem)   # BongoHi -> Bongo Hi
    stem = re.sub(r"(?<=[A-Za-z])(?=\d)", " ", stem)        # BD0 -> BD 0, Crash10 -> Crash 10
    low = " " + re.sub(r"[^a-z0-9]+", " ", stem.lower()) + " "
    for pat, code, tonal in TYPE_RULES:
        if re.search(pat, low):
            return code, tonal
    return "XX", False

# ---------------------------------------------------------------- pitch / notes
NOTE_NAMES = ["C","C#","D","D#","E","F","F#","G","G#","A","A#","B"]
OCTAVE_OFFSET = {"ableton": -2, "scientific": -1}
OCTAVE_MODE = "ableton"

def hz_to_note(f):
    if not f or f <= 0:
        return None, None, None
    midi = 69 + 12 * math.log2(f / 440.0)
    m = int(round(midi))
    cents = int(round((midi - m) * 100))
    return f"{NOTE_NAMES[m % 12]}{m // 12 + OCTAVE_OFFSET[OCTAVE_MODE]}", m, cents

def note_letter(note):
    return re.sub(r"-?\d+$", "", note) if note else None

def note_to_midi(token):
    mm = re.match(r"^([A-Ga-g])(#|b)?(-?\d+)$", token.strip())
    if not mm:
        return None
    base = {"c":0,"d":2,"e":4,"f":5,"g":7,"a":9,"b":11}[mm.group(1).lower()]
    if mm.group(2) == "#": base += 1
    if mm.group(2) == "b": base -= 1
    return base + (int(mm.group(3)) - OCTAVE_OFFSET[OCTAVE_MODE]) * 12

def _acf(seg, sr, lo, hi):
    """Return (freq, normalised peak strength 0-1)."""
    seg = seg - np.mean(seg)
    if np.max(np.abs(seg)) < 1e-9:
        return None, 0.0
    n = len(seg); w = seg * np.hanning(n)
    nfft = 1 << int(math.ceil(math.log2(2 * n)))
    spec = np.fft.rfft(w, nfft)
    acf = np.fft.irfft(spec * np.conj(spec), nfft)[:n]
    if acf[0] <= 0:
        return None, 0.0
    acfn = acf / acf[0]
    min_lag = max(2, int(sr / hi)); max_lag = min(n - 1, int(sr / lo))
    if max_lag <= min_lag:
        return None, 0.0
    lag = min_lag + int(np.argmax(acfn[min_lag:max_lag + 1]))
    strength = float(max(0.0, min(1.0, acfn[lag])))
    if 1 <= lag < n - 1:
        a0, b0, c0 = acf[lag-1], acf[lag], acf[lag+1]
        d = (a0 - 2*b0 + c0)
        lag = lag + (0.5 * (a0 - c0) / d if d else 0.0)
    return (sr / lag if lag else None), strength

def _flatness(seg):
    """Spectral flatness 0-1. Noise -> 1, pure tone -> 0."""
    mag = np.abs(np.fft.rfft(seg * np.hanning(len(seg))))
    mag = mag[mag > 0]
    if len(mag) < 8:
        return 1.0
    gm = np.exp(np.mean(np.log(mag))); am = np.mean(mag)
    return float(max(0.0, min(1.0, gm / am if am else 1.0)))

def get_fundamental(y, sr, band):
    """Return (hz, confidence 0-100)."""
    if y.ndim > 1:
        y = y.mean(axis=1)
    y = y.astype(np.float64)
    peak = np.max(np.abs(y))
    if peak < 1e-6:
        return None, 0.0
    y = y / peak
    above = np.where(np.abs(y) > 0.02)[0]
    if len(above) < 2:
        return None, 0.0
    start, end = above[0], above[-1]
    lo, hi = band
    a = max(start + int(0.40 * (end - start)), start + int(0.012 * sr))
    min_len = int(4 * sr / lo)
    if end - a < min_len:
        a = max(start + int(0.012 * sr), end - min_len)
    seg = y[a:end + 1]
    if len(seg) < int(sr / hi) * 4:
        return None, 0.0

    f, periodicity = _acf(seg, sr, lo, hi)
    if f is None or f < lo * 0.5 or f > hi * 1.5:
        return None, 0.0

    # stability: split the tail into windows, compare estimates in cents
    win = max(int(4 * sr / lo), int(0.03 * sr))
    ests = []
    for i in range(3):
        s0 = i * (len(seg) - win) // 3 if len(seg) > win else 0
        w = seg[s0:s0 + win]
        if len(w) >= int(sr / hi) * 4:
            fw, _ = _acf(w, sr, lo, hi)
            if fw and fw > 0:
                ests.append(fw)
    if len(ests) >= 2:
        cents = [1200 * math.log2(e / f) for e in ests if e > 0]
        spread = max(cents) - min(cents)
        stability = max(0.0, 1.0 - (spread / 100.0))   # 100 cents spread -> 0
    else:
        stability = 0.5

    tonality = 1.0 - _flatness(seg)

    conf = 100.0 * (max(periodicity, 1e-6) ** 0.40
                    * max(stability, 1e-6) ** 0.35
                    * max(tonality, 1e-6) ** 0.25)
    return float(f), float(max(0.0, min(100.0, conf)))

# ---------------------------------------------------------------- variants
VARIANT_RE = re.compile(
    r"[_-](aOrig|[CT]\d+[AS]?|X\d*)(_st)?$"   # tape deck / capture: C2A T1A aOrig X X1 X2
    r"|[_-]R\d+$"                        # round robin: _R1  -R3
    r"|[_-]st$", re.I)                   # stereo tag

def strip_variant(fp):
    """CR78_BD_C2A_R1.wav -> CR78_BD  (tape deck + round-robin removed)."""
    n = os.path.splitext(os.path.basename(fp))[0]
    prev = None
    while prev != n:
        prev = n
        n = VARIANT_RE.sub("", n)
    return n

def one_per_sound(analyzed):
    """Keep a single representative per unique sound. Prefers the untreated take."""
    groups = {}
    for d in analyzed:
        groups.setdefault(strip_variant(d["fp"]), []).append(d)
    out = []
    for k, g in groups.items():
        pick = next((x for x in g if "aorig" in os.path.basename(x["fp"]).lower()), None)
        if pick is None:
            pick = max(g, key=lambda x: x["conf"]) if any(x["conf"] for x in g) else g[0]
        pick = dict(pick); pick["variants"] = len(g)
        out.append(pick)
    out.sort(key=lambda d: (ORDER.index(d["code"]) if d["code"] in ORDER else 99,
                            os.path.basename(d["fp"]).lower()))
    return out

def get_shell_pitch(y, sr, band=(90, 400)):
    """Spectral-peak pitch for drums whose tail is not periodic (snare, tom, clap).
    Returns (hz, confidence 0-100). Confidence = peak prominence over the band."""
    if y.ndim > 1:
        y = y.mean(axis=1)
    y = y.astype(np.float64)
    if len(y) < 1024 or np.max(np.abs(y)) < 1e-6:
        return None, 0.0
    pk = int(np.argmax(np.abs(y)))
    seg = y[pk + int(0.010 * sr): pk + int(0.140 * sr)]
    if len(seg) < 512:
        return None, 0.0
    w = seg * np.hanning(len(seg)); n = 1 << 18
    mag = np.abs(np.fft.rfft(w, n)); fr = np.fft.rfftfreq(n, 1 / sr)
    m = (fr >= band[0]) & (fr <= band[1])
    if not m.any():
        return None, 0.0
    i = int(np.argmax(mag[m])); f = float(fr[m][i])
    prom = float(mag[m][i] / (np.median(mag[m]) + 1e-12))
    conf = 100.0 * min(1.0, max(0.0, (prom - 4.0) / 36.0))   # prom 4 -> 0%, 40 -> 100%
    return f, conf

SHELL_TYPES = {"SD": (90, 400), "TM": (60, 400), "LT": (50, 250), "MT": (70, 320),
               "HT": (90, 450), "CP": (100, 500)}

# ---------------------------------------------------------------- analysis
SKIPPED = []

def analyze_file(fp, machine=None):
    try:
        info = sf.info(fp)
    except Exception as e:
        SKIPPED.append((fp, str(e)[:60]))
        return None
    code, tonal = detect_type(fp, machine)
    hz = note = cents = None; conf = 0.0
    if code in SHELL_TYPES:
        try:
            y, _ = sf.read(fp, always_2d=False)
            hz, conf = get_shell_pitch(np.asarray(y), info.samplerate, SHELL_TYPES[code])
            if hz:
                note, _m, cents = hz_to_note(hz)
        except Exception as e:
            SKIPPED.append((fp, str(e)[:60]))
    elif tonal:
        try:
            y, _ = sf.read(fp, always_2d=False)
            hz, conf = get_fundamental(np.asarray(y), info.samplerate,
                                       TONAL_BAND.get(code, (40, 500)))
            if hz:
                note, _m, cents = hz_to_note(hz)
        except Exception as e:
            SKIPPED.append((fp, str(e)[:60]))
    return dict(fp=os.path.abspath(fp), sr=info.samplerate, frames=info.frames,
                ch=info.channels, code=code, tonal=tonal, hz=hz, note=note,
                cents=cents, conf=round(conf, 1),
                seconds=round(info.frames / info.samplerate, 3))

def analyze_machine(files, machine=None):
    out = [a for a in (analyze_file(f, machine) for f in files) if a]
    out.sort(key=lambda d: (ORDER.index(d["code"]) if d["code"] in ORDER else 99,
                            os.path.basename(d["fp"]).lower()))
    return out

# ---------------------------------------------------------------- audio preview
def make_preview_datauri(fp, max_sr=22050, max_seconds=2.5):
    y, sr = sf.read(fp, always_2d=True)
    y = y.mean(axis=1)
    if len(y) > int(max_seconds * sr):
        y = y[:int(max_seconds * sr)]
    if sr > max_sr:
        if HAVE_SCIPY:
            g = math.gcd(int(sr), max_sr)
            y = resample_poly(y, max_sr // g, sr // g)
        else:
            n = int(round(len(y) * max_sr / sr))
            y = np.interp(np.linspace(0, len(y)-1, n), np.arange(len(y)), y)
        sr = max_sr
    peak = np.max(np.abs(y)) if len(y) else 0
    if peak > 0:
        y = 0.98 * y / peak
    buf = io.BytesIO()
    sf.write(buf, y.astype(np.float32), sr, format="WAV", subtype="PCM_16")
    return "data:audio/wav;base64," + base64.b64encode(buf.getvalue()).decode()

# ---------------------------------------------------------------- audition HTML
HTML_TMPL = r"""<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8">
<title>Audition - __MACHINE__</title>
<style>
  :root{color-scheme:dark}
  body{font-family:-apple-system,Segoe UI,Roboto,sans-serif;margin:0;background:#15171c;color:#e8eaed}
  header{position:sticky;top:0;background:#1d2026;border-bottom:1px solid #2c3038;padding:14px 20px;z-index:5}
  h1{font-size:18px;margin:0 0 6px}
  .sub{color:#9aa0aa;font-size:13px}
  .bar{margin-top:10px;display:flex;gap:8px;flex-wrap:wrap;align-items:center}
  button{background:#2a2e37;color:#e8eaed;border:1px solid #3a3f4a;border-radius:8px;padding:7px 12px;font-size:13px;cursor:pointer}
  button:hover{background:#343945}
  button.primary{background:#3b82f6;border-color:#3b82f6;color:#fff}
  .count{margin-left:auto;font-size:13px;color:#9aa0aa}
  table{width:100%;border-collapse:collapse}
  td,th{padding:9px 14px;border-bottom:1px solid #23262d;text-align:left;font-size:14px}
  th{position:sticky;top:96px;background:#1d2026;color:#9aa0aa;font-weight:600;font-size:12px;text-transform:uppercase;letter-spacing:.04em}
  tr.kept{background:#171b22}
  tr.dropped{opacity:.4}
  .play{width:34px;height:34px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;padding:0;font-size:13px}
  .play.on{background:#3b82f6;border-color:#3b82f6;color:#fff}
  .ty{display:inline-block;min-width:30px;padding:2px 8px;border-radius:6px;background:#2a2e37;font-size:12px;text-align:center}
  .note{color:#86efac;font-variant-numeric:tabular-nums}
  .lowconf{color:#6b7280}
  .muted{color:#6b7280;font-size:12px}
  input[type=checkbox]{width:18px;height:18px;accent-color:#3b82f6}
  select{background:#2a2e37;color:#e8eaed;border:1px solid #3a3f4a;border-radius:6px;padding:3px 6px;font-size:12px}
  .fname{font-family:ui-monospace,Menlo,monospace;font-size:12.5px}
</style></head>
<body>
<header>
  <h1>__MACHINE__ <span class="muted">- audition &amp; pick</span></h1>
  <div class="sub">Play each sample, untick what you don't want, fix any wrong type, then download.</div>
  <div class="bar">
    <button onclick="all(true)">Keep all</button>
    <button onclick="all(false)">Drop all</button>
    <button onclick="keepType('BD')">Only kicks</button>
    <button onclick="invert()">Invert</button>
    <button class="primary" onclick="download_()">Download picks</button>
    <span class="count"><span id="n">0</span> kept</span>
  </div>
</header>
<table>
  <thead><tr><th></th><th>Keep</th><th>Type</th><th>Note</th><th>Conf</th><th>Length</th><th>File</th></tr></thead>
  <tbody id="rows"></tbody>
</table>
<audio id="player"></audio>
<script>
const MACHINE = __MACHINE_JSON__;
const SAMPLES = __SAMPLES_JSON__;
const CODES = __CODES_JSON__;
const MINCONF = __MINCONF__;
const player = document.getElementById('player');
let playing = null;
function rows(){return document.querySelectorAll('#rows tr');}
function render(){
  const tb=document.getElementById('rows'); tb.innerHTML='';
  SAMPLES.forEach((s,i)=>{
    const tr=document.createElement('tr'); tr.dataset.i=i;
    const opts=CODES.map(c=>`<option value="${c}"${c===s.code?' selected':''}>${c}</option>`).join('');
    const noteCell = s.note ? `<span class="note">${s.note}</span>` :
      (s.conf>0 ? `<span class="lowconf">- low conf</span>` : `<span class=muted>-</span>`);
    tr.innerHTML=`<td><button class="play" data-i="${i}">></button></td>
      <td><input type="checkbox" ${s.keep?'checked':''} data-i="${i}"></td>
      <td><select data-i="${i}">${opts}</select> <span class="muted">${s.label}</span></td>
      <td>${noteCell}</td>
      <td class="muted">${s.conf?s.conf.toFixed(0):''}</td>
      <td class="muted">${s.seconds}s</td>
      <td class="fname">${s.name}</td>`;
    tb.appendChild(tr);
  });
  tb.querySelectorAll('input[type=checkbox]').forEach(c=>c.addEventListener('change',e=>{
    SAMPLES[+e.target.dataset.i].keep=e.target.checked; paint();}));
  tb.querySelectorAll('select').forEach(c=>c.addEventListener('change',e=>{
    SAMPLES[+e.target.dataset.i].code=e.target.value;}));
  tb.querySelectorAll('.play').forEach(b=>b.addEventListener('click',e=>play(+e.currentTarget.dataset.i)));
  paint();
}
function play(i){
  document.querySelectorAll('.play').forEach(b=>{b.textContent='>';b.classList.remove('on');});
  if(playing===i){playing=null;player.pause();return;}
  playing=i; const b=document.querySelector(`.play[data-i="${i}"]`); b.textContent='||'; b.classList.add('on');
  player.src=SAMPLES[i].audio; player.play();
}
player.addEventListener('ended',()=>{document.querySelectorAll('.play').forEach(b=>{b.textContent='>';b.classList.remove('on');});playing=null;});
function paint(){
  let n=0;
  rows().forEach(tr=>{const s=SAMPLES[+tr.dataset.i];tr.className=s.keep?'kept':'dropped';if(s.keep)n++;});
  document.getElementById('n').textContent=n;
}
function all(v){SAMPLES.forEach(s=>s.keep=v);render();}
function invert(){SAMPLES.forEach(s=>s.keep=!s.keep);render();}
function keepType(t){SAMPLES.forEach(s=>s.keep=(s.code===t));render();}
function download_(){
  const keep=SAMPLES.filter(s=>s.keep).map(s=>({path:s.path,code:s.code}));
  const blob=new Blob([JSON.stringify({machine:MACHINE,saved:Date.now(),keep:keep},null,2)],{type:'application/json'});
  const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=MACHINE+'.picks.json';a.click();
}
render();
</script>
</body></html>
"""

def build_audition_html(machine, analyzed, out, min_conf):
    samples = []
    for d in analyzed:
        try:
            audio = make_preview_datauri(d["fp"])
        except Exception as e:
            SKIPPED.append((d["fp"], "preview: " + str(e)[:50])); audio = ""
        shown = d["note"] if (d["note"] and d["conf"] >= min_conf) else ""
        samples.append({
            "path": d["fp"], "name": os.path.basename(d["fp"]), "code": d["code"],
            "label": TYPE_LABEL.get(d["code"], d["code"]),
            "note": shown, "conf": d["conf"], "seconds": d["seconds"],
            "keep": True, "audio": audio,
        })
    page = (HTML_TMPL
            .replace("__MACHINE__", html.escape(machine))
            .replace("__MACHINE_JSON__", json.dumps(machine))
            .replace("__CODES_JSON__", json.dumps(ORDER))
            .replace("__MINCONF__", str(min_conf))
            .replace("__SAMPLES_JSON__", json.dumps(samples)))
    ad = os.path.join(out, "audition"); os.makedirs(ad, exist_ok=True)
    path = os.path.join(ad, f"{machine}.html")
    with open(path, "w", encoding="utf-8") as f:
        f.write(page)
    return path

# ---------------------------------------------------------------- .adg builder
def ableton_crc(path, cap=16384):
    """Live's OriginalCrc: CRC-16/BUYPASS (poly 0x8005, init 0) over the first 16 KB."""
    crc = 0
    with open(path, "rb") as fh:
        for b in fh.read(cap):
            crc ^= b << 8
            for _ in range(8):
                crc = ((crc << 1) ^ 0x8005) & 0xFFFF if crc & 0x8000 else (crc << 1) & 0xFFFF
    return crc

def _x(s):
    return html.escape(str(s), quote=True)

def build_branch(idx, note, basename, abspath, frames, sr, rack_dir=None):
    s = _BRANCH
    ap, bn = _x(abspath), _x(basename)
    s = s.replace(T_PATH_PRIMARY, ap).replace(T_PATH_SOURCE, ap)
    s = re.sub(r'(<BrowserContentPath Value=")[^"]*(")', r'\g<1>\g<2>', s)
    fname = _x(os.path.basename(abspath))
    # relative path from the .adg's own folder (RelativePathType 1), like Live writes for external files
    rel = _x(os.path.relpath(abspath, rack_dir).replace(os.sep, "/")) if rack_dir else fname
    s = s.replace("Samples/Imported/" + T_BASENAME + ".wav", rel)
    s = re.sub(r'(<RelativePath Value=")[^"]*'+re.escape(T_BASENAME)+r'[^"]*(")', r'\g<1>'+rel+r'\g<2>', s)
    s = re.sub(r'<RelativePathType Value="6" />', '<RelativePathType Value="1" />', s)
    s = s.replace(T_BASENAME, bn)
    size = os.path.getsize(abspath) if os.path.isfile(abspath) else 0
    crc  = ableton_crc(abspath) if os.path.isfile(abspath) else 0
    s = re.sub(r'(<OriginalFileSize Value=")\d+(")', r'\g<1>'+str(size)+r'\g<2>', s)
    s = re.sub(r'(<OriginalCrc Value=")\d+(")',      r'\g<1>'+str(crc)+r'\g<2>', s)
    s = re.sub(r'(<DefaultDuration Value=")\d+(")',  r'\g<1>'+str(int(frames))+r'\g<2>', s)
    # playback region must cover the whole file, not the template kick's 0.26 s
    for _tag in ['End', 'SampleEnd']:
        s = re.sub(r'(<'+_tag+r' Value=")\d+(")', r'\g<1>'+str(int(frames))+r'\g<2>', s)
    s = re.sub(r'(<DefaultSampleRate Value=")\d+(")',r'\g<1>'+str(int(sr))+r'\g<2>', s)
    # Live stores drum-pad notes inverted: a C1 pad (MIDI 36) is written as 128-36 = 92
    s = re.sub(r'(<ReceivingNote Value=")-?\d+(")',  r'\g<1>'+str(128 - int(note))+r'\g<2>', s)
    s = re.sub(r'(<DrumBranchPreset Id=")\d+(")',    r'\g<1>'+str(int(idx))+r'\g<2>', s, count=1)
    return s

def write_adg(path, pads):
    sep = "\n\t\t\t"
    rack_dir = os.path.dirname(os.path.abspath(path))
    branches = [build_branch(i, p["note"], p["name"], p["path"], p["frames"], p["sr"], rack_dir)
                for i, p in enumerate(pads)]
    xml = _HEAD + sep.join(branches) + _TAIL
    with gzip.open(path, "wb") as f:
        f.write(xml.encode("utf-8"))

# ---------------------------------------------------------------- conversion
def _resample(y, sr, target):
    if sr == target:
        return y, sr
    if HAVE_SCIPY:
        g = math.gcd(int(sr), target); y = resample_poly(y, target // g, sr // g)
    else:
        n = int(round(len(y) * target / sr))
        y = np.interp(np.linspace(0, len(y)-1, n), np.arange(len(y)), y)
    return y, target

def apply_peak(y, peak_db):
    """Normalise so the peak sits at peak_db dBFS."""
    if peak_db is None:
        return y
    peak = float(np.max(np.abs(y))) if len(y) else 0.0
    if peak <= 0:
        return y
    return y * ((10.0 ** (peak_db / 20.0)) / peak)

def convert_for_digitakt(src, dst, peak_db=None):
    y, sr = sf.read(src, always_2d=True); y = y.mean(axis=1)
    y, sr = _resample(y, sr, 48000)
    y = apply_peak(y, peak_db if peak_db is not None else -6.0)
    sf.write(dst, y, sr, subtype="PCM_16")

def copy_or_normalise(src, dst, peak_db):
    if peak_db is None and src.lower().endswith(".wav"):
        shutil.copy2(src, dst); return
    y, sr = sf.read(src, always_2d=True)
    y = apply_peak(y, peak_db) if peak_db is not None else y
    sf.write(dst, y, sr)

# ---------------------------------------------------------------- folder walk
def sanitize(name):
    return re.sub(r"[^A-Za-z0-9]+", "", name) or "Machine"

def _audio_under(d):
    files = []
    for dp, dns, fns in os.walk(d):
        dns[:] = [x for x in dns if not x.startswith(".") and x != "_DrumRackTool"]
        for fn in fns:
            if fn.lower().endswith(AUDIO_EXT) and not fn.startswith("."):
                files.append(os.path.join(dp, fn))
    return files

def gather(root, flat, outdir=None):
    """Collect {machine: [files]}. Never descends into the tool's own output."""
    machines = {}
    out_abs = os.path.abspath(outdir) if outdir else None
    def excluded(p):
        return out_abs and os.path.abspath(p).startswith(out_abs)
    if flat:
        files = [f for f in _audio_under(root) if not excluded(f)]
        if files:
            machines[sanitize(os.path.basename(os.path.normpath(root)))] = sorted(files)
        return machines
    for entry in sorted(os.listdir(root)):
        d = os.path.join(root, entry)
        if not os.path.isdir(d) or entry.startswith(".") or excluded(d):
            continue
        files = [f for f in _audio_under(d) if not excluded(f)]
        if not files:
            continue
        key = sanitize(entry)
        if key in machines:                      # collision: keep both
            n = 2
            while f"{key}{n}" in machines:
                n += 1
            print(f"  ! folder name collision: '{entry}' -> {key}{n}")
            key = f"{key}{n}"
        machines[key] = sorted(files)
    return machines

# ---------------------------------------------------------------- list mode
def gather_list(list_path, name):
    """Build one machine from a text file of absolute sample paths (one per line)."""
    files = []
    with open(list_path, encoding="utf-8") as fh:
        for line in fh:
            fp = line.strip()
            if not fp or fp.startswith("#"):
                continue
            fp = os.path.abspath(os.path.expanduser(fp))
            if os.path.isfile(fp) and fp.lower().endswith(AUDIO_EXT):
                files.append(fp)
            else:
                SKIPPED.append((fp, "not found or not audio"))
    return {sanitize(name): sorted(files)} if files else {}

# ---------------------------------------------------------------- SCAN
def cmd_scan(args):
    root = os.path.abspath(args.library)
    out = os.path.abspath(args.out) if args.out else os.path.join(root, "_DrumRackTool")
    os.makedirs(out, exist_ok=True)
    machines = (gather_list(args.from_list, args.name or "List")
                if getattr(args, "from_list", None) else gather(root, args.flat, out))
    if not machines:
        sys.exit("No audio files found. (Did you mean --flat?)")
    print(f"Scanning {len(machines)} machine(s) -> {os.path.join(out,'audition')}")
    print(f"Confidence gate: notes shown at >= {args.min_confidence}%\n")
    rows = []
    for m, files in machines.items():
        if not args.one_per_sound:
            print(f"[{m}] {len(files)} file(s) ...", end=" ", flush=True)
        analyzed = analyze_machine(files, m)
        if args.one_per_sound:
            full = len(analyzed); analyzed = one_per_sound(analyzed)
            print(f"[{m}] {full} files -> {len(analyzed)} unique sounds ...", end=" ", flush=True)
        build_audition_html(m, analyzed, out, args.min_confidence)
        tonal = [d for d in analyzed if d["tonal"]]
        good = [d for d in tonal if d["conf"] >= args.min_confidence]
        print(f"-> audition/{m}.html  ({len(good)}/{len(tonal)} pitched)")
        for d in analyzed:
            rows.append([m, os.path.basename(d["fp"]), d["code"],
                         "" if d["hz"] is None else f"{d['hz']:.1f}", d["note"] or "",
                         "" if d["cents"] is None else f"{d['cents']:+d}",
                         d["conf"], "yes" if d["conf"] >= args.min_confidence else "",
                         d["seconds"], d["sr"], d["ch"]])
    with open(os.path.join(out, "report.csv"), "w", newline="", encoding="utf-8") as f:
        w = csv.writer(f)
        w.writerow(["machine","file","type","pitch_hz","note","cents","confidence",
                    "above_threshold","seconds","samplerate","channels"])
        w.writerows(rows)
    if SKIPPED:
        print(f"\n! {len(SKIPPED)} file(s) could not be read - see skipped.txt")
        with open(os.path.join(out, "skipped.txt"), "w", encoding="utf-8") as f:
            for p, e in SKIPPED:
                f.write(f"{p}\t{e}\n")
    print(f"\nOpen the pages in {os.path.join(out,'audition')}, tick what you want,")
    print("click 'Download picks' for each, then run the BUILD step.")

# ---------------------------------------------------------------- picks
def load_picks(out, libroot):
    """Newest picks file per machine wins. Older files are ignored, not merged."""
    best = {}
    dirs = [os.path.join(out, "picks"), os.path.join(out, "audition"), libroot,
            os.path.expanduser("~/Downloads"), os.getcwd()]
    seen = set()
    for d in dirs:
        if not d or not os.path.isdir(d) or d in seen:
            continue
        seen.add(d)
        for fn in os.listdir(d):
            if not fn.endswith(".picks.json"):
                continue
            fp = os.path.join(d, fn)
            try:
                with open(fp) as fh:
                    data = json.load(fh)
            except Exception:
                continue
            m = data.get("machine")
            if not m:
                continue
            stamp = data.get("saved") or (os.path.getmtime(fp) * 1000)
            if m not in best or stamp > best[m][0]:
                best[m] = (stamp, data, fp)
    picks = {}
    for m, (stamp, data, fp) in best.items():
        keep = data.get("keep", [])
        entries = {}
        for k in keep:
            if isinstance(k, dict):
                entries[os.path.abspath(k.get("path", ""))] = k.get("code")
            else:
                entries[os.path.abspath(k)] = None
        picks[m] = entries
        print(f"  picks: {m} <- {os.path.basename(fp)} ({len(entries)} kept)")
    return picks

# ---------------------------------------------------------------- BUILD
def cmd_build(args):
    global OCTAVE_MODE
    OCTAVE_MODE = args.octave
    root = os.path.abspath(args.library)
    out = os.path.abspath(args.out) if args.out else os.path.join(root, "_DrumRackTool")
    os.makedirs(out, exist_ok=True)
    machines = (gather_list(args.from_list, args.name or "List")
                if getattr(args, "from_list", None) else gather(root, args.flat, out))
    if not machines:
        sys.exit("No audio files found. (Did you mean --flat?)")

    picks = {} if args.all else load_picks(out, root)
    if not picks and not args.all:
        sys.exit("No '*.picks.json' files found. Run 'scan' first and download your picks,\n"
                 "or pass --all to build every sample.")
    if args.all:
        print("--all: building every sample, picks ignored.")

    map_start = note_to_midi(args.map_start)
    if map_start is None:
        sys.exit(f"--map-start '{args.map_start}' is not a note name (try C1, F#2, Bb0).")
    if not 0 <= map_start <= MAX_MIDI:
        sys.exit(f"--map-start '{args.map_start}' is outside MIDI 0-127.")

    all_rows = []
    for m, files in machines.items():
        analyzed = analyze_machine(files, m)
        if args.one_per_sound:
            full = len(analyzed); analyzed = one_per_sound(analyzed)
            print(f"[{m}] {full} files -> {len(analyzed)} unique sounds")
        keepset = picks.get(m)
        if keepset is not None:
            analyzed = [d for d in analyzed if d["fp"] in keepset]
            for d in analyzed:                       # honour type overrides
                oc = keepset.get(d["fp"])
                if oc and oc != d["code"]:
                    d["code"] = oc
            analyzed.sort(key=lambda d: (ORDER.index(d["code"]) if d["code"] in ORDER else 99,
                                         os.path.basename(d["fp"]).lower()))
        elif not args.all:
            print(f"[{m}] no picks - skipped"); continue
        if not analyzed:
            print(f"[{m}] nothing kept - skipped"); continue
        all_rows += process_machine(m, analyzed, args, out, map_start)

    with open(os.path.join(out, "build_report.csv"), "w", newline="", encoding="utf-8") as f:
        w = csv.writer(f)
        w.writerow(["machine","original","renamed","type","pitch_hz","note","cents",
                    "confidence","tagged","seconds","samplerate","channels"])
        w.writerows(all_rows)
    print(f"\nDone. {len(all_rows)} samples built.")
    print(f"  Renamed copies : {os.path.join(out,'renamed')}")
    if args.convert: print(f"  Digitakt copies: {os.path.join(out,'digitakt')}")
    print(f"  Drum Racks     : {os.path.join(out,'racks')}  (drag a .adg into Live)")
    if SKIPPED:
        print(f"  ! {len(SKIPPED)} file(s) could not be read")
    if not args.in_place:
        print("\nYour original files were not touched.")

def select_max(analyzed, max_pads):
    """Keep at most max_pads, spread proportionally across types, evenly within each."""
    if len(analyzed) <= max_pads:
        return analyzed
    from collections import OrderedDict
    groups = OrderedDict()
    for d in analyzed:
        groups.setdefault(d["code"], []).append(d)
    n = len(analyzed); quota = {}
    for k, g in groups.items():
        quota[k] = max(1, round(max_pads * len(g) / n))
    while sum(quota.values()) > max_pads:          # trim the biggest group
        k = max(quota, key=lambda x: quota[x]); quota[k] -= 1
    while sum(quota.values()) < max_pads:          # top up the biggest group
        k = max(groups, key=lambda x: len(groups[x]) - quota[x]); quota[k] += 1
    out = []
    for k, g in groups.items():
        q = quota[k]
        if q >= len(g): out += g; continue
        step = len(g) / q
        out += [g[int(i * step)] for i in range(q)]
    out.sort(key=lambda d: (ORDER.index(d["code"]) if d["code"] in ORDER else 99,
                            os.path.basename(d["fp"]).lower()))
    return out

def process_machine(machine, analyzed, args, out, map_start):
    if getattr(args, "max_pads", None):
        full = len(analyzed); analyzed = select_max(analyzed, args.max_pads)
        if len(analyzed) < full:
            print(f"[{machine}] {full} -> {len(analyzed)} pads (max {args.max_pads}, type-balanced)")
    rows = []; counters = {}; pads = []; note = map_start; part = 1
    ren_dir = os.path.join(out, "renamed", machine)
    dig_dir = os.path.join(out, "digitakt", machine)
    os.makedirs(ren_dir, exist_ok=True)
    if args.convert: os.makedirs(dig_dir, exist_ok=True)

    def flush(pads, part, more):
        if not pads: return
        os.makedirs(os.path.join(out, "racks"), exist_ok=True)
        name = machine if (part == 1 and not more) else f"{machine}_{part}"
        write_adg(os.path.join(out, "racks", f"{name}.adg"), pads)
        print(f"[{machine}] {len(pads)} pad(s) -> racks/{name}.adg")

    for d in analyzed:
        code = d["code"]; counters[code] = counters.get(code, 0) + 1
        nn = f"{counters[code]:02d}"
        tagged = bool(d["note"]) and d["conf"] >= args.min_confidence and args.pitch_tag
        ptag = ("_" + note_letter(d["note"]).replace("#", "s")) if tagged else ""
        base = (f"{code}_{machine}{ptag}_{nn}" if args.name_order == "type"
                else f"{machine}_{code}{ptag}_{nn}")
        newname = base + ".wav"
        if args.in_place:
            dst = os.path.join(os.path.dirname(d["fp"]), base + os.path.splitext(d["fp"])[1])
            if os.path.abspath(dst) != d["fp"]:
                if os.path.exists(dst):
                    print(f"  ! refusing to overwrite {dst}"); continue
                os.rename(d["fp"], dst)
            rack_path = dst
        else:
            dst = os.path.join(ren_dir, newname)
            copy_or_normalise(d["fp"], dst, args.peak_db)
            rack_path = dst
        if args.convert:
            convert_for_digitakt(d["fp"], os.path.join(dig_dir, newname), args.peak_db)
        if note > MAX_MIDI:                       # rack full -> start another
            flush(pads, part, True); pads = []; part += 1; note = map_start
        pads.append(dict(note=note, name=base, path=os.path.abspath(rack_path),
                         frames=d["frames"], sr=d["sr"]))
        note += 1
        rows.append([machine, os.path.basename(d["fp"]), newname, code,
                     "" if d["hz"] is None else f"{d['hz']:.1f}", d["note"] or "",
                     "" if d["cents"] is None else f"{d['cents']:+d}", d["conf"],
                     "yes" if tagged else "", d["seconds"], d["sr"], d["ch"]])
    flush(pads, part, part > 1)
    return rows

# ---------------------------------------------------------------- CLI
def main():
    ap = argparse.ArgumentParser(description="Audition, curate, rename and rack drum-machine one-shots.")
    sub = ap.add_subparsers(dest="cmd", required=True)

    sc = sub.add_parser("scan", help="analyze a library and build audition web pages")
    sc.add_argument("library", nargs="?", default="."); sc.add_argument("--out", default=None)
    sc.add_argument("--flat", action="store_true", help="treat the folder itself as one machine")
    sc.add_argument("--octave", choices=["ableton","scientific"], default="ableton")
    sc.add_argument("--min-confidence", type=float, default=80.0,
                    help="hide detected notes below this confidence (default 80)")
    sc.add_argument("--from-list", default=None,
                    help="text file of sample paths, one per line (spans folders)")
    sc.add_argument("--name", default=None, help="rack name when using --from-list")
    sc.add_argument("--one-per-sound", action="store_true",
                    help="collapse tape/take variants, audition one row per unique sound")
    sc.set_defaults(func=cmd_scan)

    bd = sub.add_parser("build", help="build renamed copies + Drum Racks from your picks")
    bd.add_argument("library", nargs="?", default="."); bd.add_argument("--out", default=None)
    bd.add_argument("--flat", action="store_true")
    bd.add_argument("--all", action="store_true", help="build every sample, ignore picks")
    bd.add_argument("--convert", action="store_true", help="also write Digitakt 48k/16-bit mono copies")
    bd.add_argument("--peak-db", type=float, default=None,
                    help="normalise copies so peaks sit at this dBFS (e.g. -6)")
    bd.add_argument("--name-order", choices=["machine","type"], default="machine")
    bd.add_argument("--in-place", action="store_true", help="rename originals (destructive)")
    bd.add_argument("--no-pitch-tag", dest="pitch_tag", action="store_false")
    bd.add_argument("--min-confidence", type=float, default=80.0)
    bd.add_argument("--from-list", default=None,
                    help="text file of sample paths, one per line (spans folders)")
    bd.add_argument("--name", default=None, help="rack name when using --from-list")
    bd.add_argument("--one-per-sound", action="store_true",
                    help="collapse tape/take variants, one pad per unique sound")
    bd.add_argument("--max-pads", type=int, default=None,
                    help="cap pads per rack; keeps a type-balanced selection")
    bd.add_argument("--map-start", default="C1")
    bd.add_argument("--octave", choices=["ableton","scientific"], default="ableton")
    bd.set_defaults(func=cmd_build, pitch_tag=True)

    args = ap.parse_args()
    if args.cmd == "scan":
        global OCTAVE_MODE
        OCTAVE_MODE = args.octave
    args.func(args)

if __name__ == "__main__":
    main()
