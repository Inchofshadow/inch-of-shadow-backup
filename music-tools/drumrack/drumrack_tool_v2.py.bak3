#!/usr/bin/env python3
# drumrack_tool.py v2 -- audition, curate, rename and rack drum-machine one-shots.
# v2 changes: confidence-gated pitch, bass type, peak normalisation, no octave in
# filenames, plus the v1 bug fixes (see CHANGELOG.md).
import os, sys, re, gzip, base64, argparse, csv, shutil, math, io, json, html
import numpy as np
import soundfile as sf
try:
    from scipy.signal import resample_poly
    HAVE_SCIPY = True
except Exception:
    HAVE_SCIPY = False

