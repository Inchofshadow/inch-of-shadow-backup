<?xml version="1.0" encoding="UTF-8"?>
<!-- IG Ops Dispatcher (T-003). Runs the deterministic morning decision at
     09:30 local. Install (Amir's word required — TICKETS.md):
       cp deploy/launchd/com.inchofshadow.ig-dispatcher.plist ~/Library/LaunchAgents/
       launchctl load ~/Library/LaunchAgents/com.inchofshadow.ig-dispatcher.plist
     Uninstall:
       launchctl unload ~/Library/LaunchAgents/com.inchofshadow.ig-dispatcher.plist -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.inchofshadow.ig-dispatcher</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Library/Developer/CommandLineTools/Library/Frameworks/Python3.framework/Versions/3.9/bin/python3.9</string>
        <string>/Users/amir/Desktop/Inch of Shadow/Inchofshadowcode/scene_intelligence/ig_dispatcher.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/amir/Desktop/Inch of Shadow/Inchofshadowcode</string>
    <key>StartCalendarInterval</key>
    <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>30</integer></dict>
    <key>StandardOutPath</key>
    <string>/Users/amir/Desktop/Inch of Shadow/Inchofshadowcode/docs/reports/dispatch-launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/amir/Desktop/Inch of Shadow/Inchofshadowcode/docs/reports/dispatch-launchd.log</string>
</dict>
</plist>
