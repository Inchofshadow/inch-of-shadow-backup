    <string>/Users/amir/Desktop/Inch of Shadow/Inchofshadowcode/docs/reports/heartbeat-launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/amir/Desktop/Inch of Shadow/Inchofshadowcode/docs/reports/heartbeat-launchd.log</string>
