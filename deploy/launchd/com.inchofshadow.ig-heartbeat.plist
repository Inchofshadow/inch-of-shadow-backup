<plist version="1.0">
<dict>
    <key>Label</key><string>com.inchofshadow.ig-heartbeat</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Library/Developer/CommandLineTools/Library/Frameworks/Python3.framework/Versions/3.9/bin/python3.9</string>
        <string>/Users/amir/Desktop/Inch of Shadow/Inchofshadowcode/scene_intelligence/ig_heartbeat.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/amir/Desktop/Inch of Shadow/Inchofshadowcode</string>
    <key>StartCalendarInterval</key>
    <dict><key>Hour</key><integer>22</integer><key>Minute</key><integer>30</integer></dict>
